#--------------------------------------------------------------------
# MindTrack - Exemplo de configuracao de ambiente
# Copie para .env: cp .env.example .env
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
# O hostname deve ser o servico "db" do docker-compose.
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = mindtrack
database.default.username = mindtrack
database.default.password = mindtrack
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

