#--------------------------------------------------------------------
# MindTrack - Exemplo de configuracao de ambiente (PRODUCAO)
#--------------------------------------------------------------------
# 1. Copie para .env:  cp .env.example .env
# 2. Ajuste as credenciais de banco e a URL antes de subir para a VPS.
# 3. Gere uma chave de criptografia forte com: php spark key:generate
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Dominio FICTICIO de exemplo. Troque pelo dominio real configurado no
# VirtualHost do Apache da sua VPS.
app.baseURL = 'https://app.mindtrack.example.com/'

# Apos instalar o certificado SSL (ex.: Let's Encrypt), descomente para
# forcar HTTPS em todas as requisicoes.
# app.forceGlobalSecureRequests = true

# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Em instalacao nativa (sem Docker), o MySQL roda na propria maquina.
database.default.hostname = localhost
database.default.database = mindtrack
database.default.username = mindtrack
database.default.password = ALTERE_ESTA_SENHA_FORTE
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Gere a chave com: php spark key:generate
# Depois de gerar, o comando preenche a linha abaixo automaticamente:
# encryption.key = hex2bin:COLE_A_CHAVE_GERADA_AQUI

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# Em producao, registre apenas erros (4) para nao lotar o disco.
# logger.threshold = 4
