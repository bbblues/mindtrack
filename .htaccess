# ----------------------------------------------------------------------
# MindTrack - Bloqueio de acesso direto a raiz do projeto
# ----------------------------------------------------------------------
# Em producao, o DocumentRoot do Apache DEVE apontar para a pasta "public".
# Este arquivo existe apenas como defesa em profundidade: se o DocumentRoot
# for apontado (por engano) para a raiz do projeto, nada sera exposto.
# ----------------------------------------------------------------------

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
